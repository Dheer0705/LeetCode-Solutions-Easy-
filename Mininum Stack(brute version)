class MinStack:
    def __init__(self):
        self.stack = deque()
        self.minStack = []        
    def push(self, value: int) -> None:
        self.stack.append(value)
        if len(self.minStack) == 0:
            self.minStack.append(value)
        elif value <= self.minStack[-1]:
            self.minStack.append(value)
    def pop(self) -> None:
        x = self.stack.pop()
        if x == self.minStack[-1]:
            self.minStack.pop()
    def top(self) -> int:
        if not len(self.stack) == 0:
            return self.stack[-1]
    def getMin(self) -> int:
        return self.minStack[-1]
        
