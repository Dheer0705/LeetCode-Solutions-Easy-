class Solution:
    def maxProduct(self, nums: List[int]) -> int:
        n = len(nums)
        subarrays = []
        for i in range(n):
            for j in range(i+1,n+1):
                subarrays.append(nums[i:j])
        results = [math.prod(sub) for sub in subarrays]
        return max(results)
