class BSTIterator:

    def __init__(self, root: Optional[TreeNode]):
        self.stack = []
        def pushLeft(node):
            while node:
                self.stack.append(node)
                node = node.left
        pushLeft(root)
    def next(self) -> int:
        node = self.stack.pop()
        if node.right:
            temp = node.right
            while temp:
                self.stack.append(temp)
                temp = temp.left
        return node.val
    def hasNext(self) -> bool:
        return len(self.stack) > 0
